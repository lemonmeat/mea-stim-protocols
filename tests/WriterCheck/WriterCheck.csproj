<Project Sdk="Microsoft.NET.Sdk">
  <!-- Hardware-free check of the waveform, schedule, sideband and HDF5 code. Runs anywhere .NET 8+ runs;
       see ../README.md. The application itself is ../../MEA2100_Stimulation (.NET Framework, Windows). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>7.3</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="HDF.PInvoke.1.10" Version="1.10.612" />
    <Compile Include="..\..\MEA2100_Stimulation\ElectrodeMap.cs" />
    <Compile Include="..\..\MEA2100_Stimulation\Waveform.cs" />
    <Compile Include="..\..\MEA2100_Stimulation\Schedule.cs" />
    <Compile Include="..\..\MEA2100_Stimulation\SidebandDecoder.cs" />
    <Compile Include="..\..\MEA2100_Stimulation\McsH5Writer.cs" />
  </ItemGroup>
</Project>
